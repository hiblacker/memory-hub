NODE_ENV=development
MEMORY_HUB_API_PORT=8787
MEMORY_HUB_WEB_PORT=8788
MEMORY_HUB_PUBLIC_URL=http://localhost:8788
DATABASE_URL=postgresql://memoryhub:change-me@postgres:5432/memoryhub
MEMORY_HUB_ADMIN_TOKEN=replace-with-a-long-random-value
SIYUAN_BASE_URL=http://192.168.1.10:1166
SIYUAN_AUTH_HEADER=X-Auth-Token
SIYUAN_TOKEN_FILE=/run/secrets/siyuan_token
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY_FILE=/run/secrets/llm_api_key
LLM_MODEL=
LOG_LEVEL=info

