NODE_ENV=development
MEMORY_HUB_API_PORT=8787
MEMORY_HUB_WEB_PORT=8788
MEMORY_HUB_PUBLIC_URL=http://localhost:8788
DATABASE_URL=postgresql://memoryhub:memoryhub@localhost:5432/memoryhub
MEMORY_HUB_ADMIN_USERNAME=admin
# Development only. Production must use MEMORY_HUB_ADMIN_PASSWORD_FILE.
MEMORY_HUB_ADMIN_PASSWORD=replace-with-a-development-password
MEMORY_HUB_ADMIN_PASSWORD_FILE=
MEMORY_HUB_SESSION_TTL_MS=604800000
SIYUAN_BASE_URL=http://192.168.1.10:1166
SIYUAN_AUTH_HEADER=Authorization
SIYUAN_TOKEN_FILE=/run/secrets/siyuan_token
# Development only. Prefer SIYUAN_TOKEN_FILE in production.
SIYUAN_TOKEN=
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY_FILE=/run/secrets/llm_api_key
LLM_MODEL=
LOG_LEVEL=info
